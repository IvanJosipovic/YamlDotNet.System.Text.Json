<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" PrivateAssets="all" />
    <ProjectReference Include="..\src\YamlDotNet.System.Text.Json\YamlDotNet.System.Text.Json.csproj" SetTargetFramework="TargetFramework=net10.0" GlobalPropertiesToRemove="PublishTrimmed;TrimMode;SelfContained;RuntimeIdentifier" />
  </ItemGroup>

</Project>
